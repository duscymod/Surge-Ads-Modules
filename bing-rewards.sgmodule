#!name=Bing Rewards自动任务
#!desc=每日自动完成微软积分任务

[Script]

BingRewards-Cookie = type=http-response,pattern=^https?:\/\/(www|cn)\.bing\.com\/,requires-body=false,script-path=https://cdn.jsdelivr.net/gh/duscymod/Surge-Ads-Modules@main/bing-cookie.js,timeout=10,script-update-interval=3600
BingRewards-RewardsCookie = type=http-response,pattern=^https?:\/\/rewards\.bing\.com\/,requires-body=false,script-path=https://cdn.jsdelivr.net/gh/duscymod/Surge-Ads-Modules@main/bing-cookie.js,timeout=10,script-update-interval=3600
BingRewards-Auth = type=http-response,pattern=^https?:\/\/login\.live\.com\/oauth20_desktop\.srf,requires-body=false,script-path=https://cdn.jsdelivr.net/gh/duscymod/Surge-Ads-Modules@main/bing-cookie.js,timeout=10,script-update-interval=3600

BingRewards-Setup = type=http-request,pattern=^http:\/\/bing\.rewards\.setup\/,script-path=https://cdn.jsdelivr.net/gh/duscymod/Surge-Ads-Modules@main/bing-cookie.js,timeout=10,script-update-interval=3600

BingRewards-Daily = type=cron,cronexp=0 8 * * *,script-path=https://cdn.jsdelivr.net/gh/duscymod/Surge-Ads-Modules@main/bing-rewards.js,timeout=600,script-update-interval=3600

[MITM]
hostname = %APPEND% www.bing.com, cn.bing.com, rewards.bing.com, login.live.com
