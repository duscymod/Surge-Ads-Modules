#!name=Bing Rewards 自动任务
#!desc=Microsoft Rewards
#!requirement=SYSTEM=='iOS'

[Script]
BingRewards-Cookie = type=http-request,pattern=^https:\/\/(?:www|cn)\.bing\.com\/,requires-body=false,script-path=https://raw.githubusercontent.com/duscymod/Surge-Ads-Modules/main/bing-cookie.js,script-update-interval=3600,timeout=10
BingRewards-RewardsCookie = type=http-request,pattern=^https:\/\/rewards\.bing\.com\/,requires-body=false,script-path=https://raw.githubusercontent.com/duscymod/Surge-Ads-Modules/main/bing-cookie.js,script-update-interval=3600,timeout=10
BingRewards-Auth = type=http-request,pattern=^https:\/\/login\.live\.com\/oauth20_desktop\.srf,requires-body=false,script-path=https://raw.githubusercontent.com/duscymod/Surge-Ads-Modules/main/bing-cookie.js,script-update-interval=3600,timeout=10
BingRewards-Setup = type=http-request,pattern=^http:\/\/bing\.rewards\.setup\/,requires-body=false,script-path=https://raw.githubusercontent.com/duscymod/Surge-Ads-Modules/main/bing-cookie.js,script-update-interval=3600,timeout=10
BingRewards-Daily = type=cron,cronexp="0 8 * * *",script-path=https://raw.githubusercontent.com/duscymod/Surge-Ads-Modules/main/bing-rewards.js,script-update-interval=3600,timeout=540

[MITM]

hostname = %APPEND% www.bing.com, cn.bing.com, rewards.bing.com, login.live.com
