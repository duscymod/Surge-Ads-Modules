#!name=Umetrip No Splash Ads
#!desc=Block Umetrip old and new splash ad APIs; may affect homepage banner images

[URL Rewrite]

^https:\/\/oss\.umetrip\.com\/fs\/advert\/polite _ reject
^https?:\/\/(discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native _ reject

[MITM]

hostname = %APPEND% oss.umetrip.com, discardrp.umetrip.com, startup.umetrip.com
