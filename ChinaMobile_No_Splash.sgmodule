#!name=Douban No Splash Ads
#!desc=Remove Douban splash ads without rejecting splash APIs

[Body Rewrite]

http-response-jq ^https:\/\/api\.douban\.com\/v2\/app_ads\/splash_preload(?:\?.*)?$ '.preload_ids = null | .ads = [] | .preload_uniq_ids = []'

http-response-jq ^https:\/\/api\.douban\.com\/v2\/app_ads\/splash_show(?:\?.*)?$ '.ad_info = null | .preload_ad_id = null | .preload_ad_info = null | .backup_ad_id = null | .backup_ad_info = null | .sdk_info = "[]" | .ad_bid_info = "{}"'

[MITM]
hostname = %APPEND% api.douban.com
