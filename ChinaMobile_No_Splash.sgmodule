#!name=China Mobile No Splash Ads
#!desc=Block China Mobile app splash screen and homepage ad APIs

[URL Rewrite]

^https:\/\/(client\.app\.coc|clientaccess)\.10086\.cn\/biz-orange\/DN\/init\/startInit _ reject
^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/explorePage\/getAdverList _ reject
^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/homepagePopup\/getSortInfo$ _ reject
^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DH\/toast\/august\/getToast$ _ reject

[MITM]

hostname = %APPEND% client.app.coc.10086.cn, clientaccess.10086.cn
