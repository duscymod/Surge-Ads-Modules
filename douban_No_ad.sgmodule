#!name=豆瓣去开屏广告
#!desc=仅清空已确认的 splash_preload 广告数组

[Script]
豆瓣开屏预加载 = type=http-response,pattern=^https:\/\/api\.douban\.com\/v2\/app_ads\/splash_preload$,requires-body=true,max-size=1048576,script-path=https://raw.githubusercontent.com/duscymod/surge-scripts/refs/heads/main/douban_splash.js

[MITM]
hostname = %APPEND% api.douban.com